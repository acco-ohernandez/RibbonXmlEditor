<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>RibbonXmlEditor</RootNamespace>
    <AssemblyName>RibbonXmlEditor</AssemblyName>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>Ribbon XML Editor</Product>
    <Company>ACCO Engineered Systems</Company>
    <Description>Editor for the .ribbon XML files that define ACCO Revit ribbon tabs.</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\ButtonStructureTemplate.ribbon" LogicalName="RibbonXmlEditor.Resources.ButtonStructureTemplate.ribbon" />
  </ItemGroup>

  <!-- RibbonBuilder.cs is the Revit-side parser kept here as the canonical copy. It needs the Revit API,
       so it is not compiled into the editor; it stays visible in Solution Explorer as a plain file. -->
  <ItemGroup>
    <Compile Remove="RibbonBuilder\**" />
    <None Include="RibbonBuilder\**" />
  </ItemGroup>

</Project>
