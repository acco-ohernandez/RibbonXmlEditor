<Window x:Class="RibbonXmlEditor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RibbonXmlEditor.ViewModels"
        xmlns:v="clr-namespace:RibbonXmlEditor.Views"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding Title}" Height="800" Width="1280" MinHeight="520" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="Window_Drop">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <v:NullToVisibilityConverter x:Key="NullToVis" />
        <v:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#404040" />
            <Setter Property="Margin" Value="0,14,0,4" />
        </Style>

        <!-- Property panel for the selected node -->
        <DataTemplate x:Key="NodeEditorTemplate" DataType="{x:Type vm:NodeViewModel}">
            <StackPanel Margin="14,10,14,14">
                <StackPanel Orientation="Horizontal">
                    <Border Width="40" Height="24" CornerRadius="4" Background="{Binding GlyphBrush}" Margin="0,0,8,0">
                        <TextBlock Text="{Binding Glyph}" Foreground="White" FontSize="12" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding KindName}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="#606060" Margin="0,6,0,0" />

                <!-- Document header: only on the tab node -->
                <Border Visibility="{Binding IsTab, Converter={StaticResource BoolToVis}}"
                        Background="#F5F7FA" BorderBrush="#D8DEE6" BorderThickness="1" CornerRadius="4" Padding="10,4,10,10" Margin="0,12,0,0">
                    <StackPanel DataContext="{Binding Doc}">
                        <TextBlock Text="File header" Style="{StaticResource SectionTitle}" Margin="0,4,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Version" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Column="1" Text="{Binding Version, UpdateSourceTrigger=PropertyChanged}" Padding="3"
                                     ToolTip="Written as the Version comment at the top of the file, e.g. 2.2.0" />
                            <TextBlock Grid.Column="2" Text="Date" VerticalAlignment="Center" Margin="16,0,8,0" />
                            <DatePicker Grid.Column="3" SelectedDate="{Binding VersionDate}" Width="140" />
                            <Button Grid.Column="4" Content="Today" Padding="8,2" Margin="6,0,0,0" Command="{Binding SetTodayCommand}" />
                        </Grid>
                        <TextBlock Text="Written as: &lt;!-- Version x.y.z yyyy-mm-dd --&gt;" FontSize="11" Foreground="#707070" Margin="0,4,0,0" />
                        <StackPanel Visibility="{Binding HasOtherComments, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                            <TextBlock Text="Other comments in the file (kept as-is):" FontSize="11" Foreground="#707070" />
                            <ItemsControl ItemsSource="{Binding OtherComments}" Margin="8,2,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Attribute fields -->
                <ItemsControl ItemsSource="{Binding Fields}" Focusable="False" Margin="0,2,0,0" />

                <!-- Node-level issues -->
                <ItemsControl ItemsSource="{Binding NodeIssues}" Focusable="False" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="1" CornerRadius="3" Padding="8,5" Margin="0,0,0,4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#FFF8E1" />
                                        <Setter Property="BorderBrush" Value="#F9A825" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                <Setter Property="Background" Value="#FDECEA" />
                                                <Setter Property="BorderBrush" Value="#D32F2F" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Add-child buttons -->
                <StackPanel Visibility="{Binding CanAddChildren, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Items" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding AddChildOptions}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding ButtonText}" Command="{Binding Command}" Padding="10,4" Margin="0,0,6,6" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Right-click an item in the tree to duplicate, move or delete it." FontSize="11" Foreground="#707070" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <!-- Menu -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New" Command="{Binding NewCommand}" InputGestureText="Ctrl+N" />
                <MenuItem Header="New from _Template..." Command="{Binding NewFromTemplateCommand}"
                          ToolTip="Start from the ButtonStructureTemplate.ribbon that shows every element type" />
                <MenuItem Header="_Open..." Command="{Binding OpenCommand}" InputGestureText="Ctrl+O" />
                <MenuItem Header="Open _Recent" ItemsSource="{Binding RecentFiles}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding}" />
                            <Setter Property="Command" Value="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Menu}}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator />
                <MenuItem Header="_Save" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S" />
                <MenuItem Header="Save _As..." Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="Open _Backups Folder" Command="{Binding OpenBackupsFolderCommand}" />
                <Separator />
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="Select Tab _DLL..." Command="{Binding SelectDllCommand}"
                          ToolTip="Pick the compiled tab DLL to list its command classes in the Command class field" />
                <MenuItem Header="_Rescan DLL" Command="{Binding RescanDllCommand}" />
                <Separator />
                <MenuItem Header="Set _Images Folder..." Command="{Binding SetImagesFolderCommand}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Command="{Binding AboutCommand}" />
            </MenuItem>
        </Menu>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusPath}" ToolTip="Path of the file being edited">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDeployedCopy}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="Foreground" Value="#8A4B00" />
                                    <Setter Property="ToolTip" Value="This is a DEPLOYED copy: the next add-in deployment overwrites it." />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding IssueSummary}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding DllStatusText}" />
            </StatusBarItem>
        </StatusBar>

        <!-- Deployed-copy notice -->
        <Border DockPanel.Dock="Top" Background="#FFF4CE" BorderBrush="#E0C060" BorderThickness="0,0,0,1" Padding="10,6"
                Visibility="{Binding ShowDeployedNotice, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Dismiss" Padding="10,2" Command="{Binding DismissNoticeCommand}" VerticalAlignment="Center" />
                <TextBlock TextWrapping="Wrap" VerticalAlignment="Center">
                    <Run FontWeight="Bold" Text="You are editing a deployed copy." />
                    <Run Text="The next add-in deployment (MSI or developer build) will overwrite this file. The source of truth is the .ribbon file in the BTT_ACCORevit-Ribbons repository. Ask the developer to carry your changes into the repo so they persist." />
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- Main area -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="5" />
                <RowDefinition Height="170" MinHeight="60" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" MinWidth="220" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- Tree -->
            <TreeView x:Name="Tree" Grid.Row="0" Grid.Column="0"
                      ItemsSource="{Binding Document.RootItems}"
                      ItemContainerStyle="{StaticResource RibbonTreeItemStyle}"
                      PreviewMouseRightButtonDown="Tree_PreviewMouseRightButtonDown"
                      BorderThickness="0,0,1,0" Padding="4">
                <TreeView.InputBindings>
                    <KeyBinding Key="Delete" Command="{Binding SelectedNode.DeleteCommand}" />
                    <KeyBinding Key="Up" Modifiers="Alt" Command="{Binding SelectedNode.MoveUpCommand}" />
                    <KeyBinding Key="Down" Modifiers="Alt" Command="{Binding SelectedNode.MoveDownCommand}" />
                    <KeyBinding Key="D" Modifiers="Control" Command="{Binding SelectedNode.DuplicateCommand}" />
                </TreeView.InputBindings>
            </TreeView>

            <GridSplitter Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" Background="#E0E0E0" />

            <!-- Property panel -->
            <ScrollViewer Grid.Row="0" Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <ContentControl x:Name="Editor" Content="{Binding SelectedNode}"
                                    ContentTemplate="{StaticResource NodeEditorTemplate}" Focusable="False" />
                    <TextBlock Text="Select an item in the tree to edit it." Foreground="#808080" Margin="14">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNode}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </ScrollViewer>

            <GridSplitter Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#E0E0E0" />

            <!-- Issues -->
            <DockPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                <TextBlock DockPanel.Dock="Top" Text="{Binding IssueSummary}" FontWeight="SemiBold" Margin="8,4" />
                <ListView x:Name="IssuesList" ItemsSource="{Binding Issues}" BorderThickness="0,1,0,0"
                          MouseDoubleClick="IssuesList_MouseDoubleClick"
                          ToolTip="Double-click an issue to jump to it">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="" Width="28">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SeverityGlyph}" ToolTip="{Binding SeverityText}" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Message" Width="720" DisplayMemberBinding="{Binding Message}" />
                            <GridViewColumn Header="Location" Width="480" DisplayMemberBinding="{Binding Location}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
