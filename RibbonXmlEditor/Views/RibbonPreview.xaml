<UserControl x:Class="RibbonXmlEditor.Views.RibbonPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:RibbonXmlEditor.Views"
             Focusable="False"
             IsVisibleChanged="OnIsVisibleChanged">

    <UserControl.Resources>
        <v:PreviewTemplateSelector x:Key="Selector" />
        <v:InverseBoolConverter x:Key="InverseBool" />
        <v:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <v:NullToVisibilityConverter x:Key="NullToVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <SolidColorBrush x:Key="SelectionBrush" Color="#1E88E5" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#D32F2F" />
        <SolidColorBrush x:Key="WarningBrush" Color="#F9A825" />
        <SolidColorBrush x:Key="NeutralBorder" Color="#C8C8C8" />

        <!-- Constant 2px ring so selection never shifts the layout. -->
        <Style x:Key="SelectionRing" TargetType="Border">
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="3" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource SelectionBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Rolled-up state: for containers whose children may be hidden (drop lists). -->
        <Style x:Key="StatusBorder" TargetType="Border">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource NeutralBorder}" />
            <Setter Property="CornerRadius" Value="2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasWarning}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Own state only: for leaves and wrappers whose children are visible anyway. -->
        <Style x:Key="StatusBorderOwn" TargetType="Border">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource NeutralBorder}" />
            <Setter Property="CornerRadius" Value="2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasOwnWarning}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasOwnError}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FlatButton" TargetType="ButtonBase">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ToolTip" Value="{Binding Header}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Header}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E5F1FB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ArrowToggle" TargetType="ToggleButton" BasedOn="{StaticResource FlatButton}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="#505050" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="Open list" />
            <Setter Property="AutomationProperties.Name" Value="Open list" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#CFE4F7" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CaptionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#202020" />
        </Style>

        <!-- Icons: real image, or a coloured glyph placeholder when the image is empty or missing. -->
        <DataTemplate x:Key="Icon.Large">
            <Grid Width="32" Height="32">
                <Border Background="{Binding GlyphBrush}" CornerRadius="4" Opacity="0.75"
                        Visibility="{Binding HasLargeImage, Converter={StaticResource InverseBoolToVis}}">
                    <TextBlock Text="{Binding Glyph}" Foreground="White" FontWeight="Bold" FontSize="11"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Image Source="{Binding LargeImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="Icon.Small">
            <Grid Width="16" Height="16">
                <Border Background="{Binding GlyphBrush}" CornerRadius="2" Opacity="0.75"
                        Visibility="{Binding HasSmallImage, Converter={StaticResource InverseBoolToVis}}">
                    <TextBlock Text="{Binding Glyph}" Foreground="White" FontWeight="Bold" FontSize="8"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Image Source="{Binding SmallImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>
        </DataTemplate>

        <!-- Row inside a drop list (pulldown / split / combo members). -->
        <DataTemplate x:Key="Preview.ListItem">
            <Button Style="{StaticResource FlatButton}" Command="{Binding SelectCommand}" HorizontalContentAlignment="Stretch">
                <Border Style="{StaticResource SelectionRing}">
                    <Border Style="{StaticResource StatusBorderOwn}" Padding="4,1">
                        <StackPanel Orientation="Horizontal" Height="22" MinWidth="120">
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Icon.Small}" VerticalAlignment="Center" Focusable="False" />
                            <TextBlock Text="{Binding CaptionSingleLine}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="6,0,4,0" />
                        </StackPanel>
                    </Border>
                </Border>
            </Button>
        </DataTemplate>

        <!-- Push button / toggle button: large (icon over caption) or small (icon beside caption). -->
        <DataTemplate x:Key="Preview.Button">
            <Button Style="{StaticResource FlatButton}" Command="{Binding SelectCommand}" Margin="1">
                <Border Style="{StaticResource SelectionRing}">
                    <Border Style="{StaticResource StatusBorderOwn}" Padding="3,2">
                        <Grid>
                            <StackPanel x:Name="Large" Orientation="Vertical" MinWidth="44" MaxWidth="110" HorizontalAlignment="Center">
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Icon.Large}" HorizontalAlignment="Center" Focusable="False" />
                                <TextBlock Text="{Binding Caption}" Style="{StaticResource CaptionText}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel x:Name="Small" Orientation="Horizontal" Height="22">
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Icon.Small}" VerticalAlignment="Center" Focusable="False" />
                                <TextBlock Text="{Binding CaptionSingleLine}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="4,0,2,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Border>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsLargeInPreview}" Value="True">
                    <Setter TargetName="Small" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLargeInPreview}" Value="False">
                    <Setter TargetName="Large" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Pulldown: a button face with an arrow that drops the list of child buttons. -->
        <DataTemplate x:Key="Preview.PulldownButtons">
            <Grid>
                <Button x:Name="Root" Style="{StaticResource FlatButton}" Command="{Binding SelectCommand}" Margin="1">
                    <Border Style="{StaticResource SelectionRing}">
                        <Border Style="{StaticResource StatusBorder}" Padding="3,2">
                            <Grid>
                                <StackPanel x:Name="Large" Orientation="Vertical" MinWidth="44" MaxWidth="110" HorizontalAlignment="Center">
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Icon.Large}" HorizontalAlignment="Center" Focusable="False" />
                                    <TextBlock Text="{Binding Caption}" Style="{StaticResource CaptionText}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    <ToggleButton Style="{StaticResource ArrowToggle}" Content="▾" Height="12" Margin="0,1,0,0"
                                                  IsChecked="{Binding IsPreviewExpanded, Mode=TwoWay}"
                                                  IsHitTestVisible="{Binding IsOpen, ElementName=List, Converter={StaticResource InverseBool}}" />
                                </StackPanel>
                                <StackPanel x:Name="Small" Orientation="Horizontal" Height="22">
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Icon.Small}" VerticalAlignment="Center" Focusable="False" />
                                    <TextBlock Text="{Binding CaptionSingleLine}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="4,0,2,0" />
                                    <ToggleButton Style="{StaticResource ArrowToggle}" Content="▾" Width="14"
                                                  IsChecked="{Binding IsPreviewExpanded, Mode=TwoWay}"
                                                  IsHitTestVisible="{Binding IsOpen, ElementName=List, Converter={StaticResource InverseBool}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Border>
                </Button>
                <Popup x:Name="List" PlacementTarget="{Binding ElementName=Root}" Placement="Bottom" StaysOpen="False"
                       AllowsTransparency="True" IsOpen="{Binding IsPreviewExpanded, Mode=TwoWay}">
                    <Border Margin="4" Background="White" BorderBrush="#999999" BorderThickness="1" Padding="2">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.3" />
                        </Border.Effect>
                        <ItemsControl ItemsSource="{Binding Children}" ItemTemplate="{StaticResource Preview.ListItem}" Focusable="False" />
                    </Border>
                </Popup>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsLargeInPreview}" Value="True">
                    <Setter TargetName="Small" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLargeInPreview}" Value="False">
                    <Setter TargetName="Large" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Split button: the first child is the face, the lower arrow drops all children. -->
        <DataTemplate x:Key="Preview.SplitButtons">
            <Grid>
                <Button x:Name="Root" Style="{StaticResource FlatButton}" Command="{Binding SelectCommand}" Margin="1">
                    <Border Style="{StaticResource SelectionRing}">
                        <Border Style="{StaticResource StatusBorder}" Padding="2">
                            <StackPanel Orientation="Vertical" MinWidth="44">
                                <ContentControl Content="{Binding FirstChild}" ContentTemplateSelector="{StaticResource Selector}" Focusable="False" />
                                <TextBlock Text="(empty split button)" Foreground="#808080" Margin="4,8">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FirstChild}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ToggleButton Style="{StaticResource ArrowToggle}" Content="▾" Height="14" Background="#ECECEC"
                                              IsChecked="{Binding IsPreviewExpanded, Mode=TwoWay}"
                                              IsHitTestVisible="{Binding IsOpen, ElementName=List, Converter={StaticResource InverseBool}}" />
                            </StackPanel>
                        </Border>
                    </Border>
                </Button>
                <Popup x:Name="List" PlacementTarget="{Binding ElementName=Root}" Placement="Bottom" StaysOpen="False"
                       AllowsTransparency="True" IsOpen="{Binding IsPreviewExpanded, Mode=TwoWay}">
                    <Border Margin="4" Background="White" BorderBrush="#999999" BorderThickness="1" Padding="2">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.3" />
                        </Border.Effect>
                        <ItemsControl ItemsSource="{Binding Children}" ItemTemplate="{StaticResource Preview.ListItem}" Focusable="False" />
                    </Border>
                </Popup>
            </Grid>
        </DataTemplate>

        <!-- Combo box: an input box with an arrow that drops the members. -->
        <DataTemplate x:Key="Preview.ComboBox">
            <Grid VerticalAlignment="Center">
                <Button x:Name="Root" Style="{StaticResource FlatButton}" Command="{Binding SelectCommand}" Margin="1">
                    <Border Style="{StaticResource SelectionRing}">
                        <Border Style="{StaticResource StatusBorder}" Background="White" Width="120" Height="22">
                            <DockPanel>
                                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ArrowToggle}" Content="▾" Width="16"
                                              IsChecked="{Binding IsPreviewExpanded, Mode=TwoWay}"
                                              IsHitTestVisible="{Binding IsOpen, ElementName=List, Converter={StaticResource InverseBool}}" />
                                <TextBlock Text="{Binding CaptionSingleLine}" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                           Margin="4,0" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </Border>
                    </Border>
                </Button>
                <Popup x:Name="List" PlacementTarget="{Binding ElementName=Root}" Placement="Bottom" StaysOpen="False"
                       AllowsTransparency="True" IsOpen="{Binding IsPreviewExpanded, Mode=TwoWay}">
                    <Border Margin="4" Background="White" BorderBrush="#999999" BorderThickness="1" Padding="2">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.3" />
                        </Border.Effect>
                        <ItemsControl ItemsSource="{Binding Children}" ItemTemplate="{StaticResource Preview.ListItem}" Focusable="False" />
                    </Border>
                </Popup>
            </Grid>
        </DataTemplate>

        <!-- Text box: a small input box with optional icon and grey prompt text. -->
        <DataTemplate x:Key="Preview.TextBox">
            <Button Style="{StaticResource FlatButton}" Command="{Binding SelectCommand}" Margin="1" VerticalAlignment="Center">
                <Border Style="{StaticResource SelectionRing}">
                    <Border Style="{StaticResource StatusBorderOwn}" Background="White" Width="120" Height="22">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Icon.Small}" VerticalAlignment="Center" Margin="3,0,0,0" Focusable="False"
                                            Visibility="{Binding HasSmallImage, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding CaptionSingleLine}" Style="{StaticResource CaptionText}" Foreground="#808080" FontStyle="Italic"
                                       VerticalAlignment="Center" Margin="4,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </Border>
            </Button>
        </DataTemplate>

        <!-- Radio group: toggle buttons side by side (rendered large). -->
        <DataTemplate x:Key="Preview.RadioButtons">
            <Button Style="{StaticResource FlatButton}" Command="{Binding SelectCommand}" Margin="1" VerticalAlignment="Center">
                <Border Style="{StaticResource SelectionRing}">
                    <Border Style="{StaticResource StatusBorderOwn}" Padding="2">
                        <ItemsControl ItemsSource="{Binding Children}" ItemTemplateSelector="{StaticResource Selector}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Border>
                </Border>
            </Button>
        </DataTemplate>

        <!-- Separator: a vertical line. -->
        <DataTemplate x:Key="Preview.Separator">
            <Button Style="{StaticResource FlatButton}" Command="{Binding SelectCommand}" VerticalAlignment="Center">
                <Border Style="{StaticResource SelectionRing}">
                    <Rectangle Width="1" Height="60" Fill="#B0B0B0" Margin="3,4" />
                </Border>
            </Button>
        </DataTemplate>

        <!-- Stacked items: 1 to 3 items in a fixed-height box. -->
        <DataTemplate x:Key="Preview.StackedItems">
            <Button Style="{StaticResource FlatButton}" Command="{Binding SelectCommand}" VerticalAlignment="Center">
                <Border Style="{StaticResource SelectionRing}">
                    <Border Style="{StaticResource StatusBorderOwn}" Padding="2" Height="76">
                        <ItemsControl ItemsSource="{Binding Children}" ItemTemplateSelector="{StaticResource Selector}" Focusable="False" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Border>
                </Border>
            </Button>
        </DataTemplate>

        <!-- Slide-out: shown as a second row inside its panel when expanded. -->
        <DataTemplate x:Key="Preview.SlideoutPanel">
            <Button Style="{StaticResource FlatButton}" Command="{Binding SelectCommand}" HorizontalAlignment="Left">
                <Border Style="{StaticResource SelectionRing}">
                    <Border Style="{StaticResource StatusBorderOwn}" Background="#EAEAEA" Padding="3">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="slide-out" Style="{StaticResource CaptionText}" FontStyle="Italic" Foreground="#707070"
                                       VerticalAlignment="Center" Margin="2,0,8,0" />
                            <ItemsControl ItemsSource="{Binding Children}" ItemTemplateSelector="{StaticResource Selector}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </DockPanel>
                    </Border>
                </Border>
            </Button>
        </DataTemplate>

        <!-- Panel: items row, optional slide-out row, title bar with slide-out chevron. -->
        <DataTemplate x:Key="Preview.Panel">
            <Border Background="#F3F3F3" BorderBrush="#C6C6C6" BorderThickness="1" Margin="0,0,4,0">
                <Border Style="{StaticResource SelectionRing}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="80" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="20" />
                        </Grid.RowDefinitions>

                        <ItemsControl Grid.Row="0" ItemsSource="{Binding Children}" ItemTemplateSelector="{StaticResource Selector}"
                                      Focusable="False" Margin="4,4,4,2" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Node.Kind}" Value="SlideoutPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>

                        <ContentControl Grid.Row="1" Content="{Binding Slideout}" ContentTemplateSelector="{StaticResource Selector}"
                                        Focusable="False" Margin="4,0,4,3"
                                        Visibility="{Binding Slideout.IsPreviewExpanded, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />

                        <DockPanel Grid.Row="2" Background="#E4E4E4">
                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ArrowToggle}" Content="▾" Width="18"
                                          ToolTip="Show slide-out" AutomationProperties.Name="Slide-out"
                                          IsChecked="{Binding Slideout.IsPreviewExpanded, Mode=TwoWay}"
                                          Visibility="{Binding Slideout, Converter={StaticResource NullToVis}}" />
                            <Button Style="{StaticResource FlatButton}" Command="{Binding SelectCommand}" HorizontalContentAlignment="Center">
                                <TextBlock Text="{Binding Caption}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="6,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                            <Setter Property="Foreground" Value="#303030" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasWarning}" Value="True">
                                                    <Setter Property="Foreground" Value="#B26A00" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </DockPanel>
                    </Grid>
                </Border>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="#FAFAFA">
        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Focusable="False" Padding="6" PreviewMouseWheel="Scroller_PreviewMouseWheel">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Left" DataContext="{Binding Document}"
                        Visibility="{Binding DataContext.Document, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NullToVis}}">
                <!-- Tab chip -->
                <Button Style="{StaticResource FlatButton}" DataContext="{Binding Root}" Command="{Binding SelectCommand}" HorizontalAlignment="Left">
                    <Border Style="{StaticResource SelectionRing}">
                        <Border Background="#DDE3EA" BorderBrush="#C6C6C6" BorderThickness="1,1,1,0" CornerRadius="4,4,0,0" Padding="12,3">
                            <TextBlock Text="{Binding Caption}" FontWeight="SemiBold" FontSize="12" />
                        </Border>
                    </Border>
                </Button>
                <!-- Panels -->
                <Border Background="#E9E9E9" BorderBrush="#C6C6C6" BorderThickness="1" Padding="4">
                    <ItemsControl ItemsSource="{Binding Root.Children}" ItemTemplateSelector="{StaticResource Selector}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Margin="14" Foreground="#808080" Text="No file open. Use File > New or File > Open.">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Document}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <TextBlock Margin="14,44,14,14" Foreground="#808080" Text="This tab has no panels yet. Select the tab and click Add panel.">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Document.Root.Children.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
