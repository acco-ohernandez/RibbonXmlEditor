<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:f="clr-namespace:RibbonXmlEditor.ViewModels.Fields"
                    xmlns:v="clr-namespace:RibbonXmlEditor.Views">

    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <v:StringToVisibilityConverter x:Key="StringToVis" />
    <v:NullToVisibilityConverter x:Key="NullToVis" />

    <SolidColorBrush x:Key="ErrorBrush" Color="#D32F2F" />
    <SolidColorBrush x:Key="WarningBrush" Color="#B26A00" />
    <SolidColorBrush x:Key="HintBrush" Color="#707070" />

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,10,0,3" />
    </Style>

    <Style x:Key="FieldHint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource HintBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,3,0,0" />
    </Style>

    <Style x:Key="FieldIssue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,3,0,0" />
        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
        <Setter Property="Visibility" Value="{Binding HasIssues, Converter={StaticResource BoolToVis}}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasError}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FieldTextBox" TargetType="TextBox">
        <Setter Property="Padding" Value="3" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasWarning}" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                <Setter Property="BorderThickness" Value="1.5" />
            </DataTrigger>
            <DataTrigger Binding="{Binding HasError}" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
                <Setter Property="BorderThickness" Value="1.5" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FieldComboBox" TargetType="ComboBox">
        <Setter Property="Padding" Value="3" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasWarning}" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                <Setter Property="BorderThickness" Value="1.5" />
            </DataTrigger>
            <DataTrigger Binding="{Binding HasError}" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
                <Setter Property="BorderThickness" Value="1.5" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="FieldHeader">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" />
            <TextBlock Text=" *" Foreground="{StaticResource ErrorBrush}" Style="{StaticResource FieldLabel}"
                       ToolTip="Required by Revit"
                       Visibility="{Binding IsRequired, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="FieldFooter">
        <StackPanel>
            <TextBlock Text="{Binding Hint}" Style="{StaticResource FieldHint}"
                       Visibility="{Binding Hint, Converter={StaticResource StringToVis}}" />
            <TextBlock Text="{Binding IssueText}" Style="{StaticResource FieldIssue}" />
        </StackPanel>
    </DataTemplate>

    <!-- Plain text -->
    <DataTemplate DataType="{x:Type f:TextField}">
        <StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldHeader}" Focusable="False" />
            <TextBox Style="{StaticResource FieldTextBox}"
                     Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                     v:FocusBehavior.Field="{Binding}" />
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldFooter}" Focusable="False" />
        </StackPanel>
    </DataTemplate>

    <!-- Multi-line text (captions, tooltips) -->
    <DataTemplate DataType="{x:Type f:MultilineTextField}">
        <StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldHeader}" Focusable="False" />
            <TextBox Style="{StaticResource FieldTextBox}"
                     Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="Wrap" MinLines="2" MaxLines="14"
                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                     v:FocusBehavior.Field="{Binding}" />
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldFooter}" Focusable="False" />
        </StackPanel>
    </DataTemplate>

    <!-- URL -->
    <DataTemplate DataType="{x:Type f:UrlField}">
        <StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldHeader}" Focusable="False" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Open" Padding="10,3" Margin="6,0,0,0"
                        Command="{Binding OpenCommand}" ToolTip="Open in the browser" />
                <TextBox Style="{StaticResource FieldTextBox}"
                         Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                         v:FocusBehavior.Field="{Binding}" />
            </DockPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldFooter}" Focusable="False" />
        </StackPanel>
    </DataTemplate>

    <!-- "true" / empty flag -->
    <DataTemplate DataType="{x:Type f:TrueOrEmptyField}">
        <StackPanel Margin="0,10,0,0">
            <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Label}" FontWeight="SemiBold"
                      v:FocusBehavior.Field="{Binding}" />
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldFooter}" Focusable="False" />
        </StackPanel>
    </DataTemplate>

    <!-- Image path with thumbnail and browse -->
    <DataTemplate DataType="{x:Type f:ImagePathField}">
        <StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldHeader}" Focusable="False" />
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="36" Height="36" Margin="0,0,6,0" BorderBrush="#C0C0C0" BorderThickness="1"
                        Background="White" ToolTip="Preview">
                    <Grid>
                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="2"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="?" FontSize="18" Foreground="{StaticResource ErrorBrush}" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding IsMissing, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Border>
                <Button DockPanel.Dock="Right" Content="Clear" Padding="8,3" Margin="4,0,0,0" Command="{Binding ClearCommand}" />
                <Button DockPanel.Dock="Right" Content="Browse..." Padding="10,3" Margin="6,0,0,0" Command="{Binding BrowseCommand}" />
                <TextBox Style="{StaticResource FieldTextBox}" VerticalAlignment="Center"
                         Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                         v:FocusBehavior.Field="{Binding}" />
            </DockPanel>
            <TextBlock Text="File not found on this computer." Foreground="{StaticResource ErrorBrush}" FontSize="11" Margin="0,3,0,0"
                       Visibility="{Binding IsMissing, Converter={StaticResource BoolToVis}}" />
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldFooter}" Focusable="False" />
        </StackPanel>
    </DataTemplate>

    <!-- Command class name with DLL-backed suggestions -->
    <DataTemplate DataType="{x:Type f:ClassNameField}">
        <StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldHeader}" Focusable="False" />
            <ComboBox Style="{StaticResource FieldComboBox}" IsEditable="True" IsTextSearchEnabled="True"
                      StaysOpenOnEdit="True"
                      ItemsSource="{Binding Suggestions}"
                      Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                      v:FocusBehavior.Field="{Binding}" />
            <DockPanel Margin="0,4,0,0">
                <Button DockPanel.Dock="Right" Content="Select tab DLL..." Padding="8,2" Command="{Binding Doc.SelectDllCommand}"
                        ToolTip="Pick the compiled tab DLL (e.g. 01.ConTech_Tab.dll) to list its command classes" />
                <TextBlock Text="{Binding Doc.DllStatusText}" Style="{StaticResource FieldHint}" Margin="0,0,8,0" VerticalAlignment="Center" />
            </DockPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldFooter}" Focusable="False" />
        </StackPanel>
    </DataTemplate>

    <!-- Dockable pane class name: suggestions come from the IDockablePaneProvider scan (tab DLL + Resources DLL) -->
    <DataTemplate DataType="{x:Type f:PaneClassNameField}">
        <StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldHeader}" Focusable="False" />
            <ComboBox Style="{StaticResource FieldComboBox}" IsEditable="True" IsTextSearchEnabled="True"
                      StaysOpenOnEdit="True"
                      ItemsSource="{Binding Suggestions}"
                      Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                      v:FocusBehavior.Field="{Binding}" />
            <DockPanel Margin="0,4,0,0">
                <Button DockPanel.Dock="Right" Content="Select tab DLL..." Padding="8,2" Command="{Binding Doc.SelectDllCommand}"
                        ToolTip="Pick the compiled tab DLL; the editor also scans RevitRibbon_MainSourceCode_Resources.dll in the same folder for pane classes" />
                <TextBlock Text="{Binding Doc.PaneDllStatusText}" Style="{StaticResource FieldHint}" Margin="0,0,8,0" VerticalAlignment="Center" />
            </DockPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldFooter}" Focusable="False" />
        </StackPanel>
    </DataTemplate>

    <!-- GUID with a New button -->
    <DataTemplate DataType="{x:Type f:GuidField}">
        <StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldHeader}" Focusable="False" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="New" Padding="10,3" Margin="6,0,0,0"
                        Command="{Binding NewGuidCommand}" ToolTip="Generate a new GUID"
                        AutomationProperties.Name="New GUID" />
                <TextBox Style="{StaticResource FieldTextBox}" FontFamily="Consolas"
                         Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                         v:FocusBehavior.Field="{Binding}" />
            </DockPanel>
            <TextBlock Text="Not a valid GUID." Foreground="{StaticResource ErrorBrush}" FontSize="11" Margin="0,3,0,0"
                       Visibility="{Binding IsInvalid, Converter={StaticResource BoolToVis}}" />
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldFooter}" Focusable="False" />
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
